# Copy to .env and fill in. Never commit .env.

# Token from @BotFather (use a separate test bot for development)
BOT_TOKEN=
# HTTPS URL where the Mini App is served (your cloudflared/ngrok URL during development).
# Docker Compose sets it to https://$DOMAIN instead.
WEBAPP_URL=https://your-tunnel.example.com
# Production only (Docker Compose): the domain Caddy gets an HTTPS certificate for
DOMAIN=
# SQLite file; a relative path is resolved from the directory the server starts in.
# Docker Compose uses /data/exchange.db (./data on the server).
DB_PATH=data/exchange.db
# Folder for daily database backups (none if empty). Docker Compose uses /backups
# (./backups on the server). Backups older than BACKUP_KEEP_DAYS are deleted.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Telegram user ID of the app's owner: always an admin, and the only one who can edit
# the About page (donate options), add admins in the app and delete deals
OWNER_ID=
# Comma-separated Telegram user IDs of extra admins (moderators: reports and bans).
# The owner can also add admins in the app (Profile → Admins).
ADMIN_IDS=
# Comma-separated origins allowed to call the API (only if the frontend is on another domain)
CORS_ORIGINS=
# Max age of Telegram initData, in seconds
INIT_DATA_MAX_AGE=86400
# Set to false to run the API without the bot (no /start replies, menu button or deal messages)
RUN_BOT=true
# Set to false to disable background jobs (e.g. reference rate refresh)
RUN_JOBS=true
